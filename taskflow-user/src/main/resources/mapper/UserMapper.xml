<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taskflow.user.mapper.UserMapper">
    <select id="findActiveById" resultType="com.taskflow.user.dto.UserInfo">
        SELECT id, username
        FROM sys_user
        WHERE id = #{id}
          AND status = 'ACTIVE'
    </select>
</mapper>
