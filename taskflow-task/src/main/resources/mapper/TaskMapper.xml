
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.taskflow.task.mapper.TaskMapper">

    <insert id="insert"
            parameterType="com.taskflow.task.entity.TaskDefinition"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO task_definition
            (owner_user_id, name, status)
        VALUES
            (#{ownerUserId}, #{name}, #{status})

    </insert>

    <select id="findById"
            resultType="com.taskflow.task.entity.TaskDefinition">

        SELECT
            id,
            owner_user_id,
            name,
            status
        FROM task_definition
        WHERE id = #{id}

    </select>

</mapper>
